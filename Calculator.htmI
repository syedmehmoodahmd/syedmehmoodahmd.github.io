<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>syedMahmood Calculator</title>
<style>
body{display:flex;justify-content:center;align-items:center;height:100vh;background:#0f172a;font-family:sans-serif;margin:0}
.calc{background:#1e293b;padding:20px;border-radius:20px;box-shadow:0 10px 30px #000}
#display{width:100%;height:60px;font-size:32px;text-align:right;margin-bottom:15px;border:none;background:#334155;color:#fff;border-radius:10px;padding:0 15px;box-sizing:border-box}
.buttons{display:grid;grid-template-columns:repeat(4,70px);gap:10px}
.btn{height:60px;font-size:22px;border:none;border-radius:12px;background:#475569;color:#fff;cursor:pointer}
.btn.op{background:#f59e0b}
.btn.eq{background:#10b981;grid-column:span 2}
.btn.clr{background:#ef4444}
.btn:active{transform:scale(.95)}
</style>
</head>
<body>
<div class="calc">
<input type="text" id="display" readonly>
<div class="buttons">
<button class="btn clr" onclick="clr()">C</button>
<button class="btn op" onclick="del()">⌫</button>
<button class="btn op" onclick="dis('%')">%</button>
<button class="btn op" onclick="dis('/')">÷</button>
<button class="btn" onclick="dis('7')">7</button>
<button class="btn" onclick="dis('8')">8</button>
<button class="btn" onclick="dis('9')">9</button>
<button class="btn op" onclick="dis('*')">×</button>
<button class="btn" onclick="dis('4')">4</button>
<button class="btn" onclick="dis('5')">5</button>
<button class="btn" onclick="dis('6')">6</button>
<button class="btn op" onclick="dis('-')">−</button>
<button class="btn" onclick="dis('1')">1</button>
<button class="btn" onclick="dis('2')">2</button>
<button class="btn" onclick="dis('3')">3</button>
<button class="btn op" onclick="dis('+')">+</button>
<button class="btn" onclick="dis('0')">0</button>
<button class="btn" onclick="dis('.')">.</button>
<button class="btn eq" onclick="solve()">=</button>
</div></div>
<script>
let d=document.getElementById('display');
function dis(v){d.value+=v}
function clr(){d.value=''}
function del(){d.value=d.value.slice(0,-1)}
function solve(){try{d.value=eval(d.value)}catch{d.value='Error'}}
</script>
</body>
</html>
